{
  "productName": "lizl-work-manager",
  "version": "0.1.0",
  "identifier": "com.lizl.workmanager",
  "build": {
    "beforeDevCommand": "pnpm -C apps/desktop dev",
    "beforeBuildCommand": "pnpm -C apps/desktop build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../apps/desktop/dist"
  },
  "app": {
    "windows": [
      {
        "title": "lizl-work-manager",
        "width": 1000,
        "height": 700,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
